---
const base = import.meta.env.BASE_URL;
const slides = [
  { src: `${base}art/sts1-hero.jpg`, label: "Slay the Spire", game: "sts1" },
  { src: `${base}art/sts2-hero.jpg`, label: "Slay the Spire 2", game: "sts2" },
];
---
<div class="slides" aria-hidden="true">
  {slides.map((s, i) => (
    <figure class="slide" style={`--i:${i}`}>
      <img src={s.src} alt="" width="1920" height="620" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} />
      <figcaption class={`tag ${s.game}`}>{s.label}</figcaption>
    </figure>
  ))}
</div>

<style>
  .slides {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    animation: swap 16s infinite;
    animation-delay: calc(var(--i) * -8s);
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 17, 24, 0.15) 0%, rgba(10, 17, 24, 0.15) 45%, rgba(10, 17, 24, 0.6) 100%);
  }
  figcaption {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
  }
  @keyframes swap {
    0% { opacity: 1; }
    45% { opacity: 1; }
    50% { opacity: 0; }
    95% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      animation: none;
    }
    .slide + .slide {
      opacity: 0;
    }
  }
</style>
