---
interface Props {
  color: string;
  flip?: boolean;
  seed?: number;
}
const { color, flip = false, seed = 7 } = Astro.props;

let s = seed;
const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const points: string[] = ["0,24"];
for (let x = 0; x <= 1440; x += 18 + Math.floor(rand() * 26)) {
  points.push(`${x},${(6 + rand() * 14).toFixed(1)}`);
}
points.push("1440,10", "1440,24");
---
<svg
  class="torn"
  viewBox="0 0 1440 24"
  preserveAspectRatio="none"
  aria-hidden="true"
  style={`--torn:${color};${flip ? "transform:scaleY(-1);" : ""}`}
>
  <polygon points={points.join(" ")} />
</svg>

<style>
  .torn {
    display: block;
    width: 100%;
    height: 22px;
    margin: -1px 0;
    position: relative;
    z-index: 2;
  }
  polygon {
    fill: var(--torn);
  }
</style>
